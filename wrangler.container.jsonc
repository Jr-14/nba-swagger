{
  "name": "nba-swagger-container-probe",
  "main": "src/container-probe.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [{
    "class_name": "NbaStatsProbe",
    "image": "./containers/stats-probe/Dockerfile",
    "image_build_context": ".",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "NbaStatsProbe" }]
  },
  "exports": {
    "NbaStatsProbe": { "type": "durable-object", "storage": "sqlite" }
  }
}
