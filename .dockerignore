# Send only the Node proxy sources and dependency manifests to Docker.
# Credentials, .git, .env files, static build output, and node_modules stay out.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!shared/
!shared/*.ts
!containers/
!containers/proxy/
!containers/proxy/Dockerfile
!containers/proxy/app.ts
!containers/proxy/server.ts
