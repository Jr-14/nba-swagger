{
  "name": "nba-swagger-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://nba-swagger.pages.dev"
  },
  "containers": [{
    "class_name": "NbaProxy",
    "image": "./containers/proxy/Dockerfile",
    "image_build_context": ".",
    "instance_type": "lite",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{ "name": "PROXY", "class_name": "NbaProxy" }]
  },
  "exports": {
    "NbaProxy": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "2026110201",
    "simple": { "limit": 30, "period": 60 }
  }]
}
